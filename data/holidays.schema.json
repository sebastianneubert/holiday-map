
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "German school holiday data (per year)",
  "type": "object",
  "required": ["meta", "states"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["year"],
      "properties": {
        "year": {"type": "integer"},
        "source": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": True
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "start", "end"],
          "properties": {
            "name": {"type": "string"},
            "start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          },
          "additionalProperties": False
        }
      }
    }
  },
  "additionalProperties": False
}
